{
  "name": "cloudcode",
  "version": "0.1.0",
  "description": "Terminal AI coding agent with its own native agent engine talking directly to the Anthropic Messages API",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cloudcode": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spider2449/cloudcode.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "welcome.txt",
    "README.md",
    "docs/local-first-automation.md",
    "docs/packs",
    "examples/packs"
  ],
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src tests",
    "lint:size": "node scripts/check-file-size.mjs",
    "test": "vitest run",
    "prepack": "node -e \"require('fs').mkdirSync('release', { recursive: true })\"",
    "package:npm": "npm run build && npm pack --pack-destination release",
    "package:bin": "powershell -ExecutionPolicy Bypass -File scripts/build-binaries.ps1",
    "package:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "package": "npm run package:npm && npm run package:bin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "marked": "^15.0.12",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
